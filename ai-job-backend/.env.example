# PostgreSQL 连接地址。请复制为 .env 后填写本地真实值。
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_job?schema=public"

# MinerU Agent 轻量解析 API 无需 Token。
# 保留为环境变量，方便将来切换测试地址或标准 API。
MINERU_AGENT_BASE_URL="https://mineru.net/api/v1/agent"

# DeepSeek：真实密钥只写入 .env，不要提交到 Git。
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-v4-pro"

# JWT 登录签名密钥。生产环境必须替换为随机长字符串。
JWT_SECRET="replace-with-a-random-secret"
