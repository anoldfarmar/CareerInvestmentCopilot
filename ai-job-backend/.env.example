# =========================================================
# AI 求职助手后端环境变量示例
# 用法：cp .env.example .env 后填写真实值；不要把 .env 提交到 Git。
# 真实密钥只写入 .env 或容器 Secret，不要写进文档、截图、日志或代码。
# =========================================================

# ----- PostgreSQL -----
# 连接地址。复制为 .env 后填写本地真实值。
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_job?schema=public"

# ----- JWT -----
# 登录签名密钥。至少 24 个字符，生产环境必须替换为随机强密钥。
JWT_SECRET="replace-with-a-random-secret-of-at-least-24-chars"

# ----- Puppeteer（PDF 导出，可选）-----
# 指定 Chrome/Chromium 可执行文件路径；留空时使用 Puppeteer 内置浏览器。
PUPPETEER_EXECUTABLE_PATH=""

# ----- MinerU（简历解析）-----
MINERU_AGENT_BASE_URL="https://mineru.net/api/v1/agent"
MINERU_TIMEOUT_MS="15000"
MINERU_UPLOAD_TIMEOUT_MS="15000"
RESUME_UPLOAD_DIR="./public/resume"

# ----- DeepSeek（LLM）-----
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-v4-pro"
# 专业模拟面试各 Agent 独立模型
INTERVIEW_LISTENER_MODEL="deepseek-v4-flash"
INTERVIEW_STRATEGIST_MODEL="deepseek-v4-flash"
INTERVIEW_SPEAKER_MODEL="deepseek-v4-pro"
# full=真实模型；fast=本地规则节点（演示/降级）
INTERVIEW_PROFESSIONAL_AI_MODE="full"
DEEPSEEK_TIMEOUT_MS="60000"
# 可选：网页搜索
TAVILY_API_KEY="your-tavily-api-key"

# ----- 面试图编排（LangGraph）-----
# 新建专业面试会话默认编排版本：1 = v2 条件路由图（切题/结束判断在图内）；0 = v1 legacy
INTERVIEW_GRAPH_V2_ENABLED="0"
# 各 Agent 节点独立超时与重试（默认继承 DEEPSEEK_TIMEOUT_MS、0 次重试）
INTERVIEW_LISTENER_TIMEOUT_MS="60000"
INTERVIEW_STRATEGIST_TIMEOUT_MS="60000"
INTERVIEW_SPEAKER_TIMEOUT_MS="60000"
INTERVIEW_EVALUATOR_TIMEOUT_MS="60000"
INTERVIEW_NODE_RETRIES="0"
# Evaluator 异步化：1 = wrap_up 关键路径跳过 AI 评估（本地评分 + EVALUATING 后台执行）
INTERVIEW_EVALUATOR_ASYNC="0"

# ----- 阿里云百炼 Fun-ASR（已上传录音异步转写）-----
# 真实调用时 ASR_PUBLIC_BASE_URL 必须是云端可访问的公网 HTTPS 地址。
DASHSCOPE_API_KEY="your-dashscope-api-key"
DASHSCOPE_ASR_MODEL="fun-asr"
AUDIO_UPLOAD_DIR="./public/audio"
ASR_PUBLIC_BASE_URL="https://your-public-https-domain"

# ----- 实时语音转写（WebSocket 代理到本地 ASR，vivo/Lanxin）-----
REALTIME_ASR_PROVIDER="vivo"
LANXIN_API_BASE_URL="https://api-ai.vivo.com.cn"
LANXIN_APP_ID="your-vivo-app-id"
LANXIN_API_KEY="your-vivo-app-key"
LANXIN_ASR_ENGINE_ID="shortasrinput"
LANXIN_ASR_CLIENT_VERSION="unknown"
LANXIN_ASR_PACKAGE="unknown"
LANXIN_ASR_SDK_VERSION="unknown"
LANXIN_ASR_ANDROID_VERSION="unknown"
LANXIN_ASR_NET_TYPE="1"
LANXIN_ASR_END_VAD_TIME_MS="10000"
LANXIN_ASR_CHINESE_TO_DIGITAL="1"
LANXIN_ASR_PUNCTUATION="1"
REALTIME_ASR_WS_URL="ws://127.0.0.1:6006"

# ----- CORS -----
# 前端访问来源。多个来源用英文逗号分隔；Android WebView/Capacitor APK 常见来源为 http://localhost。
# 部署时把服务器公网地址（如 http://120.79.220.126:5174）追加到列表。
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost,capacitor://localhost,ionic://localhost,null,http://120.79.220.126:5174,http://120.79.220.126:8080"

# 安全提醒：
# 1. 旧变量名 Deepseek_API_KEY 已废弃，请统一使用 DEEPSEEK_API_KEY。
# 2. 生产环境密钥应由密钥管理服务或容器 Secret 注入。
# 3. 不要把 .env 提交到 Git。
