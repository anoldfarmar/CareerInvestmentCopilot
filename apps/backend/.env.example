APP_ENV=development
APP_NAME=zhitou-copilot
API_BASE_URL=http://127.0.0.1:8001
PUBLIC_API_BASE_URL=http://服务器公网IP:8001
ALLOW_ORIGINS=*

DATABASE_URL=sqlite:///./data/zhitou_copilot.sqlite3
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

LANXIN_API_BASE_URL=
LANXIN_API_KEY=
LANXIN_TEXT_MODEL=
LANXIN_ASR_MODEL=
LANXIN_TTS_MODEL=

AI_PROVIDER=lanxin
AI_TIMEOUT_SECONDS=60
AI_ENABLE_MOCK=true

